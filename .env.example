# Copie para .env. Não commite segredos reais.
DATABASE_URL=postgresql://pokeplace:pokeplace@localhost:5432/pokeplace
DATABASE_URL_TEST=postgresql://pokeplace:pokeplace@localhost:5432/pokeplace_test

# Obrigatório em execução, 32 caracteres ou mais. Deixe vazio neste arquivo.
AUTH_SECRET=
TAX_ID_KEY=

# Só libera pagamento simulado fora de produção. No site público permanece desligado.
SANDBOX_COMMERCE=

SEED_ADMIN_EMAIL=admin@pokeplace.local
SEED_ADMIN_PASSWORD=
SEED_BELLA_EMAIL=bella@pokeplace.local
SEED_BELLA_PASSWORD=

# Vazio importa todas as expansões do TCGdex. Uma lista limita a carga inicial.
CATALOG_SET_IDS=base1,base2,sv01,sv03.5,me01,cel25,swsh1,xy1,sm1,dp1

# Ofertas de demonstração não entram na cotação. Deixe false fora de desenvolvimento.
SEED_DEMO_OFFERS=false

NEXT_PUBLIC_BRAND_NAME=PokePlace
NEXT_PUBLIC_BRAND_DOMAIN=pokeplace.local
NEXT_PUBLIC_SUPPORT_EMAIL=contato@pokeplace.local

# Scrydex exige contrato, X-Api-Key e X-Team-ID. Sem isso o conector permanece desligado.
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
